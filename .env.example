# PressRadar runtime
# Options: local | integration | gcp
APP_MODE=local


# Operational database provider.
# gcp mode requires firestore. Docker Compose stores sqlite data in its api-data volume.
# Options: sqlite | firestore
OPERATIONAL_PROVIDER=sqlite


# Session lifetime in hours.
# Integer from 1 through 720.
SESSION_TTL_HOURS=168


# Exact browser origin allowed by the API, with scheme and optional port.
# gcp mode requires HTTPS.
WEB_ORIGIN=http://localhost:3000


# AI provider.
# fake is deterministic and makes no model requests; ollama uses the settings below.
# Options: fake | ollama
AI_PROVIDER=ollama


# Ollama URL reachable from the API container.
OLLAMA_BASE_URL=http://ollama:11434


# Analysis, headline-summary, and pitch model.
# Any valid installed Ollama model:tag.
OLLAMA_MODEL=qwen2.5:0.5b-instruct


# Translation model.
# Any valid installed Ollama model:tag.
OLLAMA_TRANSLATION_MODEL=translategemma:4b


# Per-request Ollama timeout in seconds. Number greater than 0 and at most 300.
OLLAMA_TIMEOUT_SECONDS=30


# Pitch delivery
# PITCH_SENDER options: simulated | email
# EMAIL_PROVIDER options: fake | nodemailer
# PITCH_SENDER=email requires EMAIL_PROVIDER=nodemailer.
PITCH_SENDER=simulated
EMAIL_PROVIDER=fake


# Internal HTTP(S) mailer URL reachable from the API container.
MAILER_BASE_URL=http://mailer:3001


# Shared API-to-mailer bearer token. Required when EMAIL_PROVIDER=nodemailer.
# Use a long random secret and provide the same value to both services.
MAILER_INTERNAL_TOKEN=


# SMTP server settings used by the mailer service.
# Microsoft 365 Outlook: host smtp.office365.com, port 587, secure false,
# with Authenticated SMTP enabled for the mailbox.
# SMTP_SECURE options: true | false. Use true for implicit TLS, commonly port 465.
# SMTP_PORT is an integer from 1 through 65535. SMTP_USER is the login email;
# SMTP_PASSWORD is its provider-issued password or app password.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Envelope sender email. Leave empty to use SMTP_USER.
SMTP_FROM=

# Urgent-opportunity notifications. Options: fake | twilio
# Twilio requires all three values below. Recipients come from each client's phone field.
# TWILIO_ACCOUNT_SID starts with AC; TWILIO_AUTH_TOKEN is the matching secret.
NOTIFICATION_PROVIDER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Twilio-owned sender in E.164 format, for example +15551234567.
TWILIO_FROM_NUMBER=

# CRM integration.
# HUBSPOT_ACCESS_TOKEN is a HubSpot private-app token and is required for hubspot.
# Options: fake | hubspot
CRM_PROVIDER=fake
HUBSPOT_ACCESS_TOKEN=


# Analytics provider.
# gcp mode requires bigquery. Local sqlite data uses a separate Docker volume path.
# Options: none | sqlite | bigquery
ANALYTICS_PROVIDER=sqlite


# Google Cloud settings. GCP_PROJECT_ID is required in gcp mode.
# FIRESTORE_DATABASE may be (default) or an existing Firestore database ID.
# BIGQUERY_DATASET and BIGQUERY_EVENTS_TABLE are existing BigQuery identifier names.
GCP_PROJECT_ID=
FIRESTORE_DATABASE=(default)
BIGQUERY_DATASET=pressradar_analytics
BIGQUERY_EVENTS_TABLE=product_events


# Optional NewsAPI API key for the suggested NewsAPI media source; blank disables it.
NEWSAPI_API_KEY=


# Timeout for NewsAPI, Twilio, HubSpot, and mailer calls, in seconds.
# Number greater than 0 and at most 60.
EXTERNAL_PROVIDER_TIMEOUT_SECONDS=10


# Browser-visible HTTP(S) API URL embedded into the Next.js production build.
NEXT_PUBLIC_API_URL=http://localhost:8000


# Server-side HTTP(S) API URL used by Next.js inside Docker.
API_INTERNAL_URL=http://api:8000
